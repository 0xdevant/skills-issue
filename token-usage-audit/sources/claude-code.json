{
  "name": "claude-code",
  "display_name": "Claude Code",
  "provider_hint": "anthropic",
  "roots": ["$CLAUDE_CONFIG_DIR", "~/.claude"],
  "glob": "projects/**/*.jsonl",
  "format": "jsonl",
  "session_id_from": "filename_stem",
  "capabilities": ["cache", "cache_ttl", "subagents", "tool_results", "compaction", "errors", "fingerprint"],

  "_notes": [
    "Parsing rules below were verified against 287 real transcripts (243 MB). Each one",
    "is load-bearing — getting any of them wrong invalidates every number downstream:",
    "  * dedup_key message.id — resumed sessions duplicate entries across files.",
    "  * message.usage.iterations[] is NOT summed; the top-level usage already totals",
    "    the per-API-call breakdown, so adding both double-counts.",
    "  * model '<synthetic>' is excluded — API-error placeholders with no real cost.",
    "  * isSidechain is false on every entry in this version and cannot be used to find",
    "    subagent work; that comes from toolUseResult on Task results (see events)."
  ],

  "records": {
    "select": { "type": "assistant", "message.usage": "$exists" },
    "exclude": { "message.model": "<synthetic>" },
    "dedup_key": "message.id",
    "map": {
      "model": "message.model",
      "ts": "timestamp",
      "session_id": "sessionId",
      "project": "cwd",
      "input_tokens": { "path": "message.usage.input_tokens", "default": 0 },
      "output_tokens": { "path": "message.usage.output_tokens", "default": 0 },
      "reasoning_tokens": { "path": "message.usage.output_tokens_details.thinking_tokens", "default": 0 },
      "cache_read_tokens": { "path": "message.usage.cache_read_input_tokens", "default": 0 },
      "cache_write_tokens.5m": { "path": "message.usage.cache_creation.ephemeral_5m_input_tokens", "default": 0 },
      "cache_write_tokens.1h": { "path": "message.usage.cache_creation.ephemeral_1h_input_tokens", "default": 0 },
      "error": { "path": "apiErrorStatus" }
    }
  },

  "events": [
    {
      "kind": "compaction",
      "select": { "type": "system", "subtype": "compact_boundary" },
      "map": {
        "ts": "timestamp",
        "session_id": "sessionId",
        "trigger": "compactMetadata.trigger",
        "pre_tokens": { "path": "compactMetadata.preTokens", "default": 0 },
        "post_tokens": { "path": "compactMetadata.postTokens", "default": 0 },
        "dropped_tokens": { "path": "compactMetadata.cumulativeDroppedTokens", "default": 0 }
      }
    },
    {
      "kind": "subagent",
      "select": { "toolUseResult.agentType": "$exists" },
      "map": {
        "ts": "timestamp",
        "session_id": "sessionId",
        "agent_type": "toolUseResult.agentType",
        "model": "toolUseResult.resolvedModel",
        "total_tokens": { "path": "toolUseResult.totalTokens", "default": 0 },
        "tool_uses": { "path": "toolUseResult.totalToolUseCount", "default": 0 },
        "duration_ms": { "path": "toolUseResult.totalDurationMs", "default": 0 },
        "input_tokens": { "path": "toolUseResult.usage.input_tokens", "default": 0 },
        "output_tokens": { "path": "toolUseResult.usage.output_tokens", "default": 0 },
        "cache_read_tokens": { "path": "toolUseResult.usage.cache_read_input_tokens", "default": 0 },
        "result_bytes": { "path": "toolUseResult.content", "transform": "json_bytes", "default": 0 }
      }
    },
    {
      "kind": "tool_result",
      "select": { "toolUseResult": "$exists" },
      "map": {
        "ts": "timestamp",
        "session_id": "sessionId",
        "bytes": { "path": "toolUseResult", "transform": "json_bytes", "default": 0 },
        "target": { "paths": ["toolUseResult.file.filePath", "toolUseResult.filePath"] },
        "tool_id": "message.content[type=tool_result].tool_use_id",
        "agent_type": { "path": "toolUseResult.agentType" }
      }
    },
    {
      "kind": "tool_use",
      "select": { "type": "assistant" },
      "map": {
        "ts": "timestamp",
        "session_id": "sessionId",
        "name": "message.content[type=tool_use].name",
        "tool_id": "message.content[type=tool_use].id"
      }
    },
    {
      "kind": "error",
      "select": { "type": "system", "subtype": "api_error" },
      "map": { "ts": "timestamp", "session_id": "sessionId", "detail": { "const": "api_error" } }
    },
    {
      "kind": "user_prompt",
      "select": { "type": "user", "promptSource": "$exists" },
      "map": { "ts": "timestamp", "session_id": "sessionId", "project": "cwd" }
    }
  ],

  "fingerprint": {
    "_comment": "Files that sit in the resident prefix of every request for this harness.",
    "instruction_files": ["$CLAUDE_CONFIG_DIR/CLAUDE.md", "~/.claude/CLAUDE.md"],
    "definition_globs": [
      { "root": "$CLAUDE_CONFIG_DIR", "glob": "agents/*.md", "label": "agent definitions" },
      { "root": "~/.claude", "glob": "agents/*.md", "label": "agent definitions" },
      { "root": "$CLAUDE_CONFIG_DIR", "glob": "skills/*/SKILL.md", "label": "skill definitions" },
      { "root": "~/.claude", "glob": "skills/*/SKILL.md", "label": "skill definitions" },
      { "root": "$CLAUDE_CONFIG_DIR", "glob": "commands/*.md", "label": "slash commands" },
      { "root": "~/.claude", "glob": "commands/*.md", "label": "slash commands" }
    ],
    "settings_files": ["~/.claude/settings.json", "~/.claude/settings.local.json"]
  }
}
