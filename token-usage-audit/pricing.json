{
  "schema_version": 1,
  "_comment": [
    "Rates are USD per 1,000,000 tokens. Every provider block carries source_url and",
    "fetched_at — rates must be copied from the cited page, never written from memory.",
    "Models absent from this file are reported as UNPRICED. They are never costed at zero,",
    "because a silent zero understates spend and is worse than an admitted gap.",
    "Override the whole file with: audit.mjs --pricing <file>"
  ],

  "cache_models": {
    "explicit_write_ttl": "Cache writes are billed separately at a TTL-dependent premium, reads at a discount. Requires cache_write_tokens split by TTL. (Anthropic)",
    "discounted_read": "Caching is automatic. Cached input is billed at a lower per-token rate; there is NO separate write charge. cache_write_tokens is ignored. (OpenAI)",
    "cached_content_plus_storage": "Cached content is billed at a discounted read rate PLUS a per-hour storage charge on the cached bytes. Storage cost needs cache lifetime, which harness logs rarely record — it is reported separately as unmodelled rather than guessed. (Google)",
    "none": "No cache billing. Used for local/self-hosted models, where tokens are free but context bloat still costs wall-clock time and VRAM."
  },

  "providers": {
    "anthropic": {
      "cache_model": "explicit_write_ttl",
      "source_url": "https://platform.claude.com/docs/en/about-claude/pricing",
      "fetched_at": "2026-08-13",
      "match": ["claude-", "anthropic."],
      "models": {
        "claude-fable-5":    { "input": 10, "cache_write_5m": 12.50, "cache_write_1h": 20, "cache_read": 1.00, "output": 50 },
        "claude-mythos-5":   { "input": 10, "cache_write_5m": 12.50, "cache_write_1h": 20, "cache_read": 1.00, "output": 50 },
        "claude-opus-5":     { "input": 5,  "cache_write_5m": 6.25,  "cache_write_1h": 10, "cache_read": 0.50, "output": 25 },
        "claude-opus-4-8":   { "input": 5,  "cache_write_5m": 6.25,  "cache_write_1h": 10, "cache_read": 0.50, "output": 25 },
        "claude-opus-4-7":   { "input": 5,  "cache_write_5m": 6.25,  "cache_write_1h": 10, "cache_read": 0.50, "output": 25 },
        "claude-opus-4-6":   { "input": 5,  "cache_write_5m": 6.25,  "cache_write_1h": 10, "cache_read": 0.50, "output": 25 },
        "claude-opus-4-5":   { "input": 5,  "cache_write_5m": 6.25,  "cache_write_1h": 10, "cache_read": 0.50, "output": 25 },
        "claude-opus-4-1":   { "input": 15, "cache_write_5m": 18.75, "cache_write_1h": 30, "cache_read": 1.50, "output": 75 },
        "claude-opus-4":     { "input": 15, "cache_write_5m": 18.75, "cache_write_1h": 30, "cache_read": 1.50, "output": 75 },
        "claude-sonnet-5":   { "input": 2,  "cache_write_5m": 2.50,  "cache_write_1h": 4,  "cache_read": 0.20, "output": 10 },
        "claude-sonnet-4-6": { "input": 3,  "cache_write_5m": 3.75,  "cache_write_1h": 6,  "cache_read": 0.30, "output": 15 },
        "claude-sonnet-4-5": { "input": 3,  "cache_write_5m": 3.75,  "cache_write_1h": 6,  "cache_read": 0.30, "output": 15 },
        "claude-sonnet-4":   { "input": 3,  "cache_write_5m": 3.75,  "cache_write_1h": 6,  "cache_read": 0.30, "output": 15 },
        "claude-haiku-4-5":  { "input": 1,  "cache_write_5m": 1.25,  "cache_write_1h": 2,  "cache_read": 0.10, "output": 5 },
        "claude-haiku-3-5":  { "input": 0.80, "cache_write_5m": 1.00, "cache_write_1h": 1.60, "cache_read": 0.08, "output": 4 }
      },
      "modifiers": {
        "_comment": "Applied multiplicatively to every token category when the log records them.",
        "inference_geo_us": 1.1,
        "batch": 0.5
      },
      "fast_mode": {
        "_comment": "Fast mode reprices input/output for these models; caching multipliers stack on top.",
        "claude-opus-5":   { "input": 10, "output": 50 },
        "claude-opus-4-8": { "input": 10, "output": 50 }
      }
    },

    "openai": {
      "cache_model": "discounted_read",
      "source_url": "https://developers.openai.com/api/docs/pricing",
      "fetched_at": "2026-08-13",
      "match": ["gpt-", "o1", "o3", "o4", "openai."],
      "models": {
        "gpt-5.6-sol":   { "input": 5.00,  "cache_read": 0.50,  "output": 30.00 },
        "gpt-5.6-terra": { "input": 2.00,  "cache_read": 0.20,  "output": 12.00 },
        "gpt-5.6-luna":  { "input": 0.20,  "cache_read": 0.02,  "output": 1.20 },
        "gpt-5.5":       { "input": 5.00,  "cache_read": 0.50,  "output": 30.00 },
        "gpt-5.5-pro":   { "input": 30.00, "cache_read": null,  "output": 180.00 },
        "gpt-5.4":       { "input": 2.50,  "cache_read": 0.25,  "output": 15.00 },
        "gpt-5.4-mini":  { "input": 0.75,  "cache_read": 0.075, "output": 4.50 },
        "gpt-5.4-nano":  { "input": 0.20,  "cache_read": 0.02,  "output": 1.25 },
        "gpt-5.4-pro":   { "input": 30.00, "cache_read": null,  "output": 180.00 },
        "gpt-5.2":       { "input": 1.75,  "cache_read": 0.175, "output": 14.00 },
        "gpt-5.1":       { "input": 1.25,  "cache_read": 0.125, "output": 10.00 },
        "gpt-5":         { "input": 1.25,  "cache_read": 0.125, "output": 10.00 },
        "gpt-5-mini":    { "input": 0.25,  "cache_read": 0.025, "output": 2.00 },
        "gpt-5-nano":    { "input": 0.05,  "cache_read": 0.005, "output": 0.40 },
        "gpt-4.1":       { "input": 2.00,  "cache_read": 0.50,  "output": 8.00 },
        "gpt-4.1-mini":  { "input": 0.40,  "cache_read": 0.10,  "output": 1.60 },
        "gpt-4.1-nano":  { "input": 0.10,  "cache_read": 0.025, "output": 0.40 },
        "o3":            { "input": 2.00,  "cache_read": 0.50,  "output": 8.00 },
        "o4-mini":       { "input": 1.10,  "cache_read": 0.275, "output": 4.40 },
        "o3-mini":       { "input": 1.10,  "cache_read": 0.55,  "output": 4.40 }
      }
    },

    "google": {
      "cache_model": "cached_content_plus_storage",
      "source_url": "https://ai.google.dev/gemini-api/docs/pricing",
      "fetched_at": "2026-08-13",
      "match": ["gemini-", "google.", "models/gemini"],
      "_comment": [
        "Standard tier only. Batch/Flex/Priority tiers are not modelled — harness logs do not",
        "record the tier. cache_storage_per_1m_hour is billed per hour the cache lives, which",
        "needs a lifetime the logs do not record; it is surfaced as unmodelled, not guessed.",
        "Models with length-dependent pricing list the <=200k rate and set tiered_pricing."
      ],
      "models": {
        "gemini-3.6-flash":      { "input": 1.50, "output": 7.50,  "cache_storage_per_1m_hour": 1.00 },
        "gemini-3.5-flash":      { "input": 1.50, "output": 9.00,  "cache_storage_per_1m_hour": 1.00 },
        "gemini-3.5-flash-lite": { "input": 0.30, "output": 2.50,  "cache_storage_per_1m_hour": 1.00 },
        "gemini-3.1-flash-lite": { "input": 0.25, "output": 1.50,  "cache_storage_per_1m_hour": 1.00 },
        "gemini-3.1-pro":        { "input": 2.00, "output": 12.00, "cache_storage_per_1m_hour": 4.50, "tiered_pricing": { "over_200k": { "input": 4.00, "output": 18.00 } } },
        "gemini-2.5-pro":        { "input": 1.25, "output": 10.00, "cache_storage_per_1m_hour": 4.50, "tiered_pricing": { "over_200k": { "input": 2.50, "output": 15.00 } } },
        "gemini-2.5-flash":      { "input": 0.30, "output": 2.50,  "cache_storage_per_1m_hour": 1.00 }
      }
    },

    "local": {
      "cache_model": "none",
      "source_url": null,
      "fetched_at": null,
      "match": ["ollama/", "local/", "llama", "qwen", "mistral", "deepseek-r1", "gemma", "phi"],
      "_comment": "Self-hosted: zero marginal token cost. Still analyzed for context bloat, which costs wall-clock time and VRAM even when the tokens are free.",
      "models": {
        "*": { "input": 0, "cache_read": 0, "output": 0 }
      }
    }
  }
}
